## Kubernetes Manifests

### namespace.yaml
```yaml
apiVersion: v1
kind: Namespace
metadata:
  name: hotel
  labels:
    project: grand-residency
    tier: all
```

### backend/configmap.yaml
```yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: backend-config
  namespace: hotel
data:
  PORT: "5050"
  NODE_ENV: "production"
  MONGO_URI: "mongodb://mongodb:27017/hoteldb"
```

### backend/deployment.yaml
```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  namespace: hotel
  labels:
    app: backend
    tier: application
spec:
  replicas: 2
  selector:
    matchLabels:
      app: backend
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app: backend
        tier: application
    spec:
      containers:
      - name: backend
        image: bharathyk2004/hotel-backend:latest
        imagePullPolicy: Never
        ports:
        - containerPort: 5050
        envFrom:
        - configMapRef:
            name: backend-config
        resources:
          requests:
            cpu: "100m"
            memory: "128Mi"
          limits:
            cpu: "300m"
            memory: "256Mi"
        livenessProbe:
          httpGet:
            path: /health
            port: 5050
          initialDelaySeconds: 15
          periodSeconds: 20
        readinessProbe:
          httpGet:
            path: /health
            port: 5050
          initialDelaySeconds: 5
          periodSeconds: 10
```

### backend/service.yaml
```yaml
apiVersion: v1
kind: Service
metadata:
  name: backend
  namespace: hotel
spec:
  selector:
    app: backend
  ports:
  - port: 5050
    targetPort: 5050
  type: ClusterIP
```

### frontend/deployment.yaml
```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: hotel
  labels:
    app: frontend
    tier: presentation
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app: frontend
        tier: presentation
    spec:
      containers:
      - name: frontend
        image: bharathyk2004/hotel-frontend:latest
        imagePullPolicy: Never
        ports:
        - containerPort: 80
        resources:
          requests:
            cpu: "50m"
            memory: "64Mi"
          limits:
            cpu: "200m"
            memory: "128Mi"
        livenessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 10
          periodSeconds: 20
        readinessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 5
          periodSeconds: 10
```

### frontend/service.yaml
```yaml
apiVersion: v1
kind: Service
metadata:
  name: frontend
  namespace: hotel
spec:
  selector:
    app: frontend
  ports:
  - port: 80
    targetPort: 80
  type: ClusterIP
```

### mongodb/statefulset.yaml
```yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mongodb
  namespace: hotel
  labels:
    app: mongodb
    tier: data
spec:
  serviceName: mongodb
  replicas: 1
  selector:
    matchLabels:
      app: mongodb
  template:
    metadata:
      labels:
        app: mongodb
        tier: data
    spec:
      containers:
      - name: mongodb
        image: mongo:6.0
        ports:
        - containerPort: 27017
        resources:
          requests:
            cpu: "200m"
            memory: "256Mi"
          limits:
            cpu: "500m"
            memory: "512Mi"
        volumeMounts:
        - name: mongo-storage
          mountPath: /data/db
        livenessProbe:
          exec:
            command:
            - mongosh
            - "--eval"
            - "db.runCommand('ping')"
          initialDelaySeconds: 30
          periodSeconds: 10
  volumeClaimTemplates:
  - metadata:
      name: mongo-storage
    spec:
      accessModes: ["ReadWriteOnce"]
      resources:
        requests:
          storage: 1Gi
```

### mongodb/service.yaml
```yaml
apiVersion: v1
kind: Service
metadata:
  name: mongodb
  namespace: hotel
spec:
  selector:
    app: mongodb
  ports:
  - port: 27017
    targetPort: 27017
  clusterIP: None
```

### ingress/ingress.yaml
```yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hotel-ingress
  namespace: hotel
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  ingressClassName: nginx
  rules:
  - host: hotel.local
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: frontend
            port:
              number: 80
      - path: /api
        pathType: Prefix
        backend:
          service:
            name: backend
            port:
              number: 5050
      - path: /health
        pathType: Prefix
        backend:
          service:
            name: backend
            port:
              number: 5050
```

---

## Step by Step Deploy on Minikube

### Step 1 — Start Minikube

```bash
minikube start --memory=4096 --cpus=2
minikube addons enable ingress
minikube addons enable metrics-server
```

### Step 2 — Build Images Inside Minikube

```bash
# Point Docker to minikube's daemon
eval $(minikube docker-env)

# Build both images
docker build -t bharathyk2004/hotel-frontend:latest ./frontend
docker build -t bharathyk2004/hotel-backend:latest ./backend

# Verify images exist
docker images | grep hotel
```

### Step 3 — Apply Manifests in Order

```bash
# 1. Create namespace first
kubectl apply -f k8s/namespace.yaml

# 2. Deploy MongoDB (data tier)
kubectl apply -f k8s/mongodb/

# Wait for MongoDB to be ready
kubectl wait --for=condition=ready pod \
  -l app=mongodb -n hotel --timeout=90s

# 3. Deploy Backend API (application tier)
kubectl apply -f k8s/backend/

# Wait for backend
kubectl rollout status deployment/backend -n hotel

# 4. Deploy Frontend (presentation tier)
kubectl apply -f k8s/frontend/

# Wait for frontend
kubectl rollout status deployment/frontend -n hotel

# 5. Apply Ingress
kubectl apply -f k8s/ingress/
```

### Step 4 — Add Hotel.local to Hosts File

```bash
echo "$(minikube ip) hotel.local" | sudo tee -a /etc/hosts
```

### Step 5 — Access the Application

```bash
# Method 1 — via Ingress (recommended)
# Open in browser:
http://hotel.local

# Method 2 — port forward frontend
kubectl port-forward svc/frontend 3000:80 -n hotel
# Open: http://localhost:3000

# Method 3 — port forward backend
kubectl port-forward svc/backend 5050:5050 -n hotel
curl http://localhost:5050/health
```

---

## Verify All 3 Tiers Running

```bash
# See everything in namespace
kubectl get all -n hotel

# Expected output:
# pod/frontend-xxx    Running  ← Tier 1
# pod/frontend-xxx    Running  ← Tier 1
# pod/backend-xxx     Running  ← Tier 2
# pod/backend-xxx     Running  ← Tier 2
# pod/mongodb-0       Running  ← Tier 3

# Check pods by tier
kubectl get pods -n hotel -l tier=presentation
kubectl get pods -n hotel -l tier=application
kubectl get pods -n hotel -l tier=data
```

---

## View Booking Data Stored in MongoDB

```bash
# Go inside MongoDB pod
kubectl exec -it mongodb-0 -n hotel -- mongosh

# Inside mongosh:
use hoteldb
db.bookings.find().pretty()
db.bookings.countDocuments()
exit
```

---

## Test the Full Flow

```bash
# 1. Port forward backend for direct testing
kubectl port-forward svc/backend 5050:5050 -n hotel &

# 2. Create a test booking
curl -X POST http://localhost:5050/api/bookings \
  -H "Content-Type: application/json" \
  -d '{
    "guestName": "Bharathy K",
    "email": "bharathyk2004@gmail.com",
    "phone": "8610335742",
    "roomType": "Deluxe Room",
    "checkIn": "2026-08-01",
    "checkOut": "2026-08-03"
  }'

# 3. Verify booking saved
curl http://localhost:5050/api/bookings

# 4. Go inside MongoDB and confirm
kubectl exec -it mongodb-0 -n hotel -- \
  mongosh --eval "use hoteldb; db.bookings.find().pretty()"
```

---

## Scaling Each Tier Independently

```bash
# Scale frontend (Tier 1)
kubectl scale deployment frontend --replicas=3 -n hotel

# Scale backend (Tier 2)
kubectl scale deployment backend --replicas=4 -n hotel

# MongoDB (Tier 3) stays at 1 for single-node setup
# In production → use MongoDB replica set

# Watch pods scale
kubectl get pods -n hotel -w
```

---

## Rolling Update

```bash
# Update backend image
kubectl set image deployment/backend \
  backend=bharathyk2004/hotel-backend:v2 -n hotel

# Watch zero-downtime rollout
kubectl rollout status deployment/backend -n hotel

# Rollback if needed
kubectl rollout undo deployment/backend -n hotel
```

